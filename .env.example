# Copy this file to `.env` and fill in the values, then run:
#   npx prisma migrate dev
#   npx prisma db seed
#
#   cp .env.example .env

# --- Database -------------------------------------------------------------
# Local development uses SQLite, a single file — no database server required.
# The path is resolved by prisma.config.ts (for the Prisma CLI) and by
# lib/prisma.ts (for the Next.js app), so keep it as `file:./dev.db`.
DATABASE_URL="file:./dev.db"

# For a PostgreSQL deployment, swap the two lines above for e.g.
#   DATABASE_URL="postgresql://user:password@host:5432/acadex?schema=public"
# and change `provider` in prisma/schema.prisma to "postgresql".

# --- Authentication -------------------------------------------------------
# Secret used to sign the session JWT (jose, HS256). Must be set or the app
# will refuse to issue or verify sessions.
# Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
